# --- ROS 2 / colcon build output --------------------------------------------
# The container build at the workspace root; the native build lives in
# native/build and native/install and is covered by native/.gitignore.
build/
install/
log/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.Python

# Virtualenvs. Both project venvs are generated by ./install.sh and are large
# (native/venv ~3.5 GB, VLM/.venv ~8 GB), so they are never committed.
# `.venv/` is listed explicitly: uv writes a .gitignore inside the venv it
# creates, but relying on that means the ignore breaks if the venv is ever made
# another way.
venv/
.venv/
env/
ENV/

# --- Secrets / local environment --------------------------------------------
.env
.env.*
!.env.example

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Crash dumps and stray runtime output ------------------------------------
core.*
*.log

# Frames dumped by the VLM debug tools (VLM/pixel_to_world.py writes these).
pixel_to_world_frame.png

# --- test artefacts ----------------------------------------------------------
# test_vlm_geometry.py renders an annotated frame so the dot and coordinates can
# be looked at rather than argued about. Useful to open, not to commit.
VLM/test_debug_render.png
vlm_detection.png

# Scratch states file and motion log written by test_pick_cycle.py. Named per
# process so two copies of the suite cannot clobber each other.
native/tests/.test_states.*.yaml
native/tests/.test_motion_log.*.jsonl

# Append-only record of every commanded motion, for debugging a run
# after the fact. Grows without bound; never committed.
motion_log.jsonl
