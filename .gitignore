# --- ROS 2 / colcon build output --------------------------------------------
# The container build at the workspace root; the native build lives in
# native/build and native/install and is covered by native/.gitignore.
build/
install/
log/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.Python

# Virtualenvs. The two project venvs are generated (native/venv ~3.5 GB by
# ./install.sh, box_picker/src/.venv by box_picker/src/setup.sh) and large, so
# they are never committed.
# `.venv/` is listed explicitly: uv writes a .gitignore inside the venv it
# creates, but relying on that means the ignore breaks if the venv is ever made
# another way.
venv/
.venv/
env/
ENV/

# --- Secrets / local environment --------------------------------------------
.env
.env.*
!.env.example

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Crash dumps and stray runtime output ------------------------------------
core.*
*.log

# --- superseded files ------------------------------------------------------
# old_version/ is committed, except the old container build output inside it.
old_version/container/build/
old_version/container/install/
