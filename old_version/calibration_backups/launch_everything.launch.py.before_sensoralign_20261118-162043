def lidar_nodes(context):
    """The L2: the user's own driver (4D_lidar's l2_driver, their l2.yaml) and
    robot/lidar_bridge.py, as lidar:= says. Only the driver of their stack: their
    l2_stabilizer hangs l2_lidar on a floor 'world' of its own (not the robot's)."""
    import subprocess
    cfg = context.launch_configurations
    mode = cfg.get('lidar', 'serial').strip().lower()
    if mode in ('off', 'false', 'none', '0'):
        print('[launch_everything] the Unitree L2 LiDAR is off (lidar:=off): the unseen-space '
              'walls are used')
        return []
    nodes = []
    already = subprocess.run(['pgrep', '-x', 'l2_driver_node'], capture_output=True,
                             text=True).stdout.split()
    if already:
        # one driver per L2: the port is taken, and their stabilizer's world -> l2_lidar
        # would give l2_lidar a second parent
        print(f'[launch_everything] an L2 driver is already running (pid {" ".join(already)}): '
              'is 4D_lidar/scripts/l2.sh running? Stop it (scripts/l2.sh stop) and restart this; '
              'until then no LiDAR here, the walls are used.')
    elif not os.access(L2_DRIVER, os.X_OK):
        print(f'[launch_everything] the L2 driver is not built ({L2_DRIVER}): no LiDAR, the walls '
              'are used. Build 4D_lidar (its README).')
    else:
        # work_mode stays -1 (their l2.yaml): never write the L2's stored mode. It starts the
        # L2 rotating (~25 s from standby to the first cloud) and stops it at Ctrl-C
        nodes.append(ExecuteProcess(
            cmd=[L2_DRIVER, '--ros-args', '-r', '__node:=l2_driver', '--params-file', L2_CONFIG,
                 '-p', f"connection:={'udp' if mode == 'udp' else 'serial'}",
                 '-p', f"serial_port:={cfg.get('lidar_port')}",
                 '-p', f"lidar_ip:={cfg.get('lidar_ip', '192.168.1.62')}",
                 '-p', f"local_ip:={cfg.get('lidar_local_ip', '192.168.1.2')}"],
            output='screen', name='l2_driver', respawn=True, respawn_delay=5.0,
            sigterm_timeout='15'))
    f = lambda k, d: float(cfg.get(k, d))
    nodes.append(ExecuteProcess(
        cmd=['python3', '/workspaces/isaac_ros-dev/robot/lidar_bridge.py', '--ros-args',
             '-p', 'in_topic:=/l2/cloud', '-p', 'imu_topic:=/l2/imu',
             '-p', f"mount_xyz:=[{f('lidar_x', -0.0625)}, {f('lidar_y', 0.0592)}, {f('lidar_z', 0.8666)}]",
             '-p', f"mount_rpy_deg:=[{f('lidar_roll', 3.19)}, {f('lidar_pitch', 114.16)}, {f('lidar_yaw', -0.13)}]",
             '-p', f"mount_spin_deg:={f('lidar_spin', 161.30)}",
             '-p', f"tilt_from_imu:={'false' if cfg.get('lidar_tilt', 'measured') != 'imu' else 'true'}",
             '-p', f"octomap_live:={'false' if cfg.get('octomap', 'live') == 'static' else 'true'}"],
        output='screen', additional_env={'PYTHONUNBUFFERED': '1'}, name='lidar_bridge',
        respawn=True, respawn_delay=2.0))
    return nodes


def generate_launch_description():
    use_fake_hardware = LaunchConfiguration('use_fake_hardware')
    right_can = LaunchConfiguration('right_can_interface')
    left_can = LaunchConfiguration('left_can_interface')
    octomap_mode = LaunchConfiguration('octomap')
    tool_frame = LaunchConfiguration('tool_frame')
    collision_distance = LaunchConfiguration('collision_activation_distance')
    
    declare_fake_hardware = DeclareLaunchArgument(
        'use_fake_hardware',
        default_value='false',
        description='Use fake hardware'
    )
    declare_right_can = DeclareLaunchArgument(
        'right_can_interface',
        default_value='can0',
    )
    declare_left_can = DeclareLaunchArgument(
        'left_can_interface',
        default_value='can1',
    )
    declare_octomap = DeclareLaunchArgument(
        'octomap',
        default_value='live',
        description='Octomap mode: live or static'
    )
    declare_use_rviz = DeclareLaunchArgument(
        'use_rviz',
        default_value='true',
        description='Start RViz. false on a headless or VNC session: without '
                    'hardware GL it hangs at start-up with its window never '
                    'mapped, and nothing else needs it.'
    )
    declare_4d = DeclareLaunchArgument(
        '4d',
        default_value='false',
        description='unused since 2026-11-11 (its placeholder TF clashed with the L2 '
                    "driver's own frames): the Unitree L2 is lidar:=serial|udp|off"
    )
    # The Unitree L2 4D LiDAR (2026-11-11): the user's driver (4D_lidar's l2_driver) and
    # robot/lidar_bridge.py (its mount, its cloud in the robot's frames, the merged cloud,
    # the walls' switch). serial: the USB serial adapter (the L2 is in serial mode);
    # udp: Ethernet (the PC at lidar_local_ip); off: neither. Not with 4D_lidar's
    # scripts/l2.sh running at the same time.
    declare_lidar = [
        DeclareLaunchArgument('lidar', default_value='serial',
                              description='the Unitree L2: serial, udp or off'),
        DeclareLaunchArgument('lidar_port', default_value='/dev/serial/by-id/'
                              'usb-1a86_USB_Single_Serial_593A033327-if00',
                              description="the L2's USB serial adapter (by id)"),
        DeclareLaunchArgument('lidar_ip', default_value='192.168.1.62',
                              description="udp: the L2's address (factory 192.168.1.62)"),
        DeclareLaunchArgument('lidar_local_ip', default_value='192.168.1.2',
                              description='udp: this PC on the L2\'s network (factory 192.168.1.2)'),
        # 2026-11-12 17:30: FITTED to the camera (ICP of its cloud onto the D455's, window cleaned):
        # agreement 30% -> 54%. The tape measure said (0.0154, 0.0062, 0.8457); the fit is 6.7 cm
        # behind and 3.9 cm left of that (lidar_x / lidar_y / lidar_z below).
        # 2026-11-13 10:00: RE-FITTED to the robot's own body as the LiDAR sees it (the URDF at the
        # live TF) together with the camera: 4 cm to the robot's right (y 0.045 -> 0.005, the tape's
        # y), 3.5 cm up, pitch +2.7 deg. Its points on the body: 1.5 -> 0.9 cm median gap, 58 -> 87%
        # within 2 cm; on the left hand 5.9 -> 1.4 cm; the camera's agreement unchanged (54%).
        # 10:10 the user: 2 cm further right by eye (y 0.0045 -> -0.0155).
        # 11:40 RE-FITTED on two postures (parked, and the right arm in the workspace: its LiDAR points
        # were 3.5 cm right of the drawn arm): y back to 0.003, yaw +2. The arm's points: 4.5 -> 3.0 cm
        # median gap (2.6 with the range trim), 69 -> 91% inside the self-filter's 6 cm.
        # the mount, in openarm_body_link0 (m, deg): 111.3 mm above the centre of the
        # two arms' bases (0.0126, 0.0062, 0.7344), 2.8 mm in front. Turned (2026-11-12, as the
        # user set it in RViz, then levelled on the room against gravity as the D455 measures it in
        # the robot frame -- the robot leans ~5 deg forward -- walls square, 2026-11-12): blue (dome) forward 30 deg below level, red up-forward leaning left, green right
        # 2026-11-16T16:55: set by hand with robot/sensor_align.py (live; 76.0 mm / 2.03 deg from the values before).
        # 2026-11-16T16:58: set by hand with robot/sensor_align.py (live; 38.0 mm / 0.00 deg from the values before).
        # 2026-11-16T17:20: set by hand with robot/sensor_align.py (live; 8.0 mm / 0.00 deg from the values before).
        DeclareLaunchArgument('lidar_x', default_value='-0.0625'),
        DeclareLaunchArgument('lidar_y', default_value='0.0592'),
        DeclareLaunchArgument('lidar_z', default_value='0.8666'),
        DeclareLaunchArgument('lidar_roll', default_value='3.19'),
        DeclareLaunchArgument('lidar_pitch', default_value='114.16',
                              description='deg, + = its top (the dome, blue) tipped forward from upright: '
                                          '120 = the dome 30 deg below level, toward the box'),
        DeclareLaunchArgument('lidar_yaw', default_value='-0.13',
                              description='deg, its X turned left of straight ahead (about the '
                                          "robot's vertical; which side of it faces where: lidar_spin)"),
        DeclareLaunchArgument('lidar_spin', default_value='161.30',
                              description='deg, then turned about its own Z (blue in RViz, the dome '
                                          'axis): which side faces where (with pitch ~120: 180 = red up-forward; '
                                          'less = red turned to the left)'),
        DeclareLaunchArgument('lidar_tilt', default_value='measured',
                              description="measured: lidar_roll/pitch/yaw; imu: its tilt from its "
                                          "own accelerometer (on 2026-11-12 this L2's read 1.9 g "
                                          "at rest: not to be trusted)"),
    ]
    # cuMotion has a single ee_link and rejects any pose goal aimed at a
    # different link with INVALID_LINK_NAME, so this is what decides which arm
    # can be given Cartesian goals -- from RViz or from pick_place_orchestrator.
    # The other arm still takes joint-space goals. Both arms stay in the
    # kinematic chain either way; see the note in openarm.yml.
    # cuRobo's own default is 0.01 m. 0.03 keeps the arm 2 cm further off
    # everything in the octomap, which is the knob to reach for when it clips
    # obstacles it planned around -- it inflates every voxel, so raising it too
    # far will make tight approaches unplannable.
    declare_collision_distance = DeclareLaunchArgument(
        'collision_activation_distance',
        default_value='0.03',
        description='Clearance cuMotion keeps from every obstacle, metres.'
    )
    # The D455's minimum depth range shrinks with the depth resolution: about
    # 0.4-0.5 m at 848x480, about 0.2 m at 424x240. With the V3 mount
    # (cam_org.txt) the camera looks flat at surfaces 0.3-0.5 m away, inside
    # the 848x480 blind zone, so click_to_move read wrong depths there. The
    # old high, tilted mount saw the table from further off, which is why
    # 848x480 was fine for the VLM. Go back to 848x480x15 only for work that
    # is all beyond ~0.5 m: it is more precise at range.
    # 640x480 (2026-10-29): three times the depth points of 424x240, for the box
    # picker -- a box top seen at a shallow angle got too few points at 424x240
    # and lost to the box's front -- still measuring from ~0.34 m. Use
    # depth_profile:=424x240x15 for work nearer than that.
    # auto (2026-11-04): on when the D455's motion sensor can be read -- the
    # RealSense udev rules. Without them the camera node hung at start with it on
    # (2026-10-29): its /dev/iio devices were root's only. Off, the box picker
    # uses the accelerometer's last saved reading (calibration/camera_tilt.yaml),
    # else the TF's tilt, which is not gravity's.
    imu_ok = realsense_imu_readable()
    if not imu_ok:
        print('[launch_everything] the D455 accelerometer is off: its motion sensor is not '
              'readable (install the RealSense udev rules, then replug the camera; see '
              'docs/cmds.md). accel:=true forces it on.')
    declare_accel = DeclareLaunchArgument(
        'accel', default_value='true' if imu_ok else 'false',
        description='the D455 accelerometer (the box picker\'s up direction). Default: on when '
                    'its motion sensor is readable (the RealSense udev rules), else off')
    # (2026-11-18) the gyro too, and both as one sensor_msgs/Imu on /camera/camera/imu
    # (unite_imu_method 2: the accelerometer interpolated to each gyro sample). The
    # separate /camera/camera/accel/sample (the box picker's) and /gyro/sample stay.
    gyro_ok = realsense_imu_readable('gyro_3d')
    declare_gyro = DeclareLaunchArgument(
        'gyro', default_value='true' if (imu_ok and gyro_ok) else 'false',
        description='the D455 gyro, and with the accelerometer the united /camera/camera/imu. '
                    'Default: on when both motion sensors are readable')
    declare_depth_profile = DeclareLaunchArgument(
        'depth_profile',
        default_value='640x480x15',
        description='D455 depth stream WxHxFPS. Lower resolution = shorter '
                    'minimum range (424x240: ~0.2 m, 640x480: ~0.34 m, 848x480: ~0.45 m).'
    )
    declare_boot_pre_pick = DeclareLaunchArgument(
        'boot_pre_pick',
        default_value='true',
        description='Once move_group is up, walk both arms to their recorded '
                    'navigation_state (boot_pre_pick.py; click_to_move switches '
                    'to pre_pick when picking starts).'
    )
    # The vacuum relay (2026-11-05): app/vacuum_bridge.py writes the pick stack's
    # /beast_arm/vacuum to the ESP32 ('1' / '0' over USB serial). Here, with the
    # rest of the hardware, so the GUI's restarts leave it alone: opening the port
    # restarts the ESP32, and a box on the cup would drop.
    declare_vacuum = DeclareLaunchArgument(
        'vacuum',
        default_value='true',
        description='Start the vacuum relay bridge (app/vacuum_bridge.py: '
                    '/beast_arm/vacuum -> the ESP32 over USB serial).'
    )
    declare_vacuum_port = DeclareLaunchArgument(
        'vacuum_port',
        default_value='/dev/serial/by-id/'
                      'usb-Espressif_USB_JTAG_serial_debug_unit_34:CD:B0:16:1D:30-if00',
        description="The ESP32's serial port (default: its own USB port by id, "
                    "/dev/ttyACM0 now; auto = the only USB serial device there is)."
    )
    declare_tool_frame = DeclareLaunchArgument(
        'tool_frame',
        default_value='openarm_right_hand_tcp',
        description='Link cuMotion plans Cartesian goals for. Use '
                    'openarm_left_hand_tcp for left-arm pose goals.'
    )
    
    # 1. Include the MoveIt demo launch file
    demo_launch_file = os.path.join(
        get_package_share_directory('openarm_bimanual_moveit_config'),
        'launch',
        'demo.launch.py'
    )
    
    demo_launch = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(demo_launch_file),
        launch_arguments={
            'use_fake_hardware': use_fake_hardware,
            'right_can_interface': right_can,
            'left_can_interface': left_can,
            'use_rviz': LaunchConfiguration('use_rviz'),
        }.items()
    )
    
    # 2. Add the cuMotion GPU Action Server Node
    cumotion_node = Node(
        package='isaac_ros_cumotion',
        executable='cumotion_goal_set_planner_node',
        name='cumotion_planner',
        parameters=[{
            'robot': '/workspaces/isaac_ros-dev/robot/openarm.yml',
            'robot_file': '/workspaces/isaac_ros-dev/robot/openarm.yml',
            'robot_filepath': '/workspaces/isaac_ros-dev/robot/openarm.yml',
            'tool_frame': tool_frame,
            'collision_activation_distance': collision_distance,
        }],
        output='screen',
        # cuMotion is a Python node and launch pipes its stdout, so without this
        # its output block-buffers and is lost when it dies. It has crashed here
        # with SIGFPE (exit code -8) leaving nothing but launch's own "process
        # has died" line, which says nothing about why.
        additional_env={'PYTHONUNBUFFERED': '1'},
        # Bring it back when it dies, because it does. SIGFPE (exit code -8) in
        # most launches on 2026-09-07, and the whole cell is useless without it:
        # move_group's cumotion pipeline forwards every goal to this node, so a
        # dead planner turns even a joint goal to a recorded posture into
        # TIMED_OUT.
        #
        # The delay is for the CUDA kernels it loads on startup -- it logs
        # nothing at all while it does, and respawning faster than it can come
        # up would just churn. The orchestrator's readiness probe covers the
        # window where it is back but not yet planning.
        respawn=True,
        respawn_delay=4.0,
    )
    
    is_static = PythonExpression(["'", octomap_mode, "' == 'static'"])
    is_live = PythonExpression(["'", octomap_mode, "' != 'static'"])

    launch_nodes = [
        declare_fake_hardware,
        declare_right_can,
        declare_left_can,
        declare_octomap,
        declare_use_rviz,
        declare_4d,
        declare_tool_frame,
        declare_collision_distance,
        declare_boot_pre_pick,
        declare_depth_profile,
        declare_accel,
        declare_gyro,
        declare_vacuum,
        declare_vacuum_port,
        *declare_lidar,
        DeclareLaunchArgument('level_pitch', default_value='0.0',
                              description="deg: how far the robot's frame leans against gravity (the "
                                          "'level' frame RViz looks in; see below)"),
        DeclareLaunchArgument('level_roll', default_value='0.0'),
        demo_launch,
        cumotion_node,
        # the boot walk waits for the LiDAR and a filled octomap before anything moves
        # (boot_pre_pick.py); with lidar:=off, for the camera's map alone
        ExecuteProcess(
            cmd=['python3', '/workspaces/isaac_ros-dev/robot/boot_pre_pick.py'],
            output='screen',
            additional_env={'PYTHONUNBUFFERED': '1'},
            condition=IfCondition(PythonExpression([
                "'", LaunchConfiguration('boot_pre_pick'), "' == 'true' and '",
                LaunchConfiguration('lidar'), "' != 'off'"])),
        ),
        ExecuteProcess(
            cmd=['python3', '/workspaces/isaac_ros-dev/robot/boot_pre_pick.py', '--without-lidar'],
            output='screen',
            additional_env={'PYTHONUNBUFFERED': '1'},
            condition=IfCondition(PythonExpression([
                "'", LaunchConfiguration('boot_pre_pick'), "' == 'true' and '",
                LaunchConfiguration('lidar'), "' == 'off'"])),
        ),
        # It catches every serial error itself (unplugged: it reopens the port);
        # respawned only if it dies anyway, else the vacuum would stay as it was.
        ExecuteProcess(
            cmd=['python3', '/workspaces/isaac_ros-dev/app/vacuum_bridge.py', '--ros-args',
                 '-p', ['port:=', LaunchConfiguration('vacuum_port')]],
            output='screen',
            additional_env={'PYTHONUNBUFFERED': '1'},
            name='vacuum_bridge',
            respawn=True,
            respawn_delay=2.0,
            condition=IfCondition(LaunchConfiguration('vacuum')),
        ),
    ]

    # (the old 4d:=true TF bridge, robot_tf_bringup, is not started any more: it hung
    # unilidar_lidar 25 cm in front of base_link, which Unitree's stock L2 driver also parents)
    launch_nodes.append(OpaqueFunction(function=lidar_nodes))

    # 'level': a frame for LOOKING (RViz's Fixed Frame), with gravity straight down. The robot's own
    # frame ('world') leans against the room: the D455's accelerometer through its calibrated TF has
    # up at (-0.092, -0.004, 0.996) in it (5.3 deg), and the ceiling in the L2's cloud is tilted
    # 4.6 deg the same way (2026-11-13). Nothing plans in 'level': MoveIt, the octomap, the walls and
    # the pick stack stay in 'world'. level_pitch / level_roll (deg) turn world inside it; 0 0 = as before.
    launch_nodes.append(Node(
        package='tf2_ros', executable='static_transform_publisher', name='level_frame',
        arguments=['--x', '0', '--y', '0', '--z', '0',
                   '--roll', PythonExpression(['str(', LaunchConfiguration('level_roll'), ' * 0.017453293)']),
                   '--pitch', PythonExpression(['str(', LaunchConfiguration('level_pitch'), ' * 0.017453293)']),
                   '--yaw', '0', '--frame-id', 'level', '--child-frame-id', 'world']))


    # 3. Add the RealSense Camera Node
    #
    # Colour and depth-to-colour alignment are on because the box picker (via
    # box_picker/src/ros_bridge.py) and the pick stack need them: they cannot open
    # the D455 themselves while this driver holds it, so they subscribe to
    # /camera/camera/color/image_raw and
    # /camera/camera/aligned_depth_to_color/image_raw instead. The aligned depth
    # follows the colour resolution, so /camera/camera/color/camera_info is the
    # one set of intrinsics that describes both.
    #
    # Colour is 640x480x15: this D455's RGB sensor offers only 1280x720,
    # 1280x800x8, 640x480 and 424x240 (ros2 param describe /camera/camera
    # rgb_camera.color_profile), so asking for depth's 848x480 silently fell
    # back to 640x480 anyway.
    #
    # Note the aligned topic is *not* affected by the octomap gater's remap below,
    # so the VLM keeps seeing live frames even with octomap:=static.
    try:
        realsense_launch_file = os.path.join(
            get_package_share_directory('realsense2_camera'),
            'launch',
            'rs_launch.py'
        )

        realsense_args = {
            'depth_module.depth_profile': LaunchConfiguration('depth_profile'),
            'rgb_camera.color_profile': '640x480x15',
            'pointcloud.enable': 'false',
            'align_depth.enable': 'true',
            'enable_color': 'true',
            # the D455's accelerometer: the true "up" for the box picker (box_model_node).
            # From the TF the picker was told the camera looked 4.5 deg up; the scene
            # showed ~4.7 deg down, the boxes' tops lost to their fronts (2026-10-29)
            'enable_accel': LaunchConfiguration('accel'),
            'enable_gyro': LaunchConfiguration('gyro'),
            'unite_imu_method': '2',                 # /camera/camera/imu (needs both)
        }

        realsense_node_live = IncludeLaunchDescription(
            PythonLaunchDescriptionSource(realsense_launch_file),
            launch_arguments=realsense_args.items(),
            condition=IfCondition(is_live)
        )

        realsense_node_static = GroupAction([
            SetRemap(src='/camera/camera/depth/image_rect_raw', dst='/camera/camera/depth/image_rect_raw_in'),
            IncludeLaunchDescription(
                PythonLaunchDescriptionSource(realsense_launch_file),
                launch_arguments=realsense_args.items()
            )
        ], condition=IfCondition(is_static))
        
        octomap_gater = ExecuteProcess(
            cmd=['python3', '/workspaces/isaac_ros-dev/robot/octomap_gater.py'],
            output='screen',
            condition=IfCondition(is_static)
        )
        
        launch_nodes.extend([realsense_node_live, realsense_node_static, octomap_gater])
        
    except Exception as e:
        # If realsense2_camera is not installed, fallback to just the robot without crashing
        print(f"\n[WARNING]: realsense2_camera package not found! Please run 'sudo apt-get install ros-humble-realsense2-camera ros-humble-realsense2-description -y' inside the container.\n")
    
    return LaunchDescription(launch_nodes)
