# RIGHT arm motor control law, read by openarm_hardware (v10_simple_hardware.cpp)
# once, when the hardware starts: edit, then restart terminal 1 (the stack).
# Created 2026-11-17, with the left arm's (see calibration/motor_gains_left.yaml
# for what each key does, the bounds and the all-or-nothing rule).
#
# The right arm gets the two switches the controller yaml change brings to both
# arms (velocity feed-forward, the integral held while the command moves), so
# they can be turned off here per arm. No gains profile: the precision work was
# on the left arm, and nothing here has been tried on the right one.

arm: right

velocity_feedforward: true
integral_freeze_while_moving: true
freeze_rate: 0.01     # rad/s
freeze_hold: 0.15     # s
zero_velocity_when_held: true

profile_enabled: false
