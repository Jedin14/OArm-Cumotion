# Everything here is regenerated by ./bootstrap.sh, and it is ~4.5 GB.
# The scripts, requirements.txt, setup.bash, tests and README are the source of
# truth and are tracked; the artefacts are not.

# Downloaded / unpacked debs (~360 MB)
debs/
root/

# Python venv (~3.5 GB) -- also matched by the workspace .gitignore
venv/

# colcon output -- also matched by the workspace .gitignore
build/
install/

# Private apt state, JIT caches, logs, fetched MoveIt source
aptroot/
cache/
logs/
src_moveit/

# Generated: openarm.yml with the container path rewritten for local testing
openarm_native.yml
